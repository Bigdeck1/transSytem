flowchart TD
    %% JRR Transport Logistics Management System
    %% Process 1: Authentication, Role-Based Access & Session Management

    Start([User Visits index.html]) --> Input[/Enter Email/Username & Password/]
    Input --> ClickLogin[Click Login Button]
    ClickLogin --> APILogin[POST /api/auth/login]
    
    APILogin --> SupaAuth[Call Supabase Auth:\nsignInWithPassword]
    SupaAuth --> CheckCred{Valid Credentials?}

    %% Credentials Validation
    CheckCred -- No --> ShowErr[Display Error Alert:\n'Invalid credentials']
    ShowErr --> Input

    CheckCred -- Yes --> GetToken[Receive Access Token & User ID]
    GetToken --> QueryEmp[(Query employees table\nWHERE supabase_user_id = user.id)]
    
    QueryEmp --> CheckActive{Is Account Active?}

    %% Account Status Validation
    CheckActive -- No --> ErrDeactive[Return HTTP 403:\n'Account is deactivated']
    ErrDeactive --> Input

    CheckActive -- Yes --> GenSession[Create User Session Payload:\nfull_name, position, department, status]
    GenSession --> LocalStore[Store in localStorage:\ntoken & session_user]
    
    %% Role-Based Routing
    LocalStore --> CheckRole{Check User Position}
    
    CheckRole -- Admin / Manager --> NavAdmin[Redirect to dashboard.html\n/ admin_panel.html]
    CheckRole -- Driver --> NavDriver[Redirect to tracking.html\n/ Driver Task Console]
    CheckRole -- Staff / Dispatcher --> NavStaff[Redirect to scheduling_page.html]

    %% Password Recovery Sub-Process
    subgraph Password_Recovery ["Password Recovery Sub-Flow"]
        ForgotClick([Click 'Forgot Password?']) --> NavForgot[Open forgot_password_page.html]
        NavForgot --> InputForgotEmail[/Enter Registered Email/]
        InputForgotEmail --> PostForgot[POST /api/auth/forgot-password]
        PostForgot --> SendResetMail[Supabase Dispatches Reset Email Link]
        SendResetMail --> OpenResetMail[User Opens Email Link in Browser]
        OpenResetMail --> SetNewPass[/Enter & Confirm New Password/]
        SetNewPass --> UpdatePass[(Supabase Updates Password Hash)]
        UpdatePass --> SuccessReset[Display Success Notice]
        SuccessReset --> Start
    end

    %% Styles
    classDef terminal fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#ffffff;
    classDef process fill:#0f172a,stroke:#818cf8,stroke-width:1.5px,color:#f8fafc;
    classDef decision fill:#312e81,stroke:#a5b4fc,stroke-width:2px,color:#ffffff;
    classDef database fill:#064e3b,stroke:#34d399,stroke-width:2px,color:#ffffff;
    classDef errorNode fill:#7f1d1d,stroke:#f87171,stroke-width:1.5px,color:#fecaca;

    class Start,NavAdmin,NavDriver,NavStaff,ForgotClick,Done terminal;
    class ClickLogin,APILogin,SupaAuth,GetToken,GenSession,LocalStore,NavForgot,PostForgot,SendResetMail,OpenResetMail,SetNewPass,SuccessReset process;
    class CheckCred,CheckActive,CheckRole decision;
    class QueryEmp,UpdatePass database;
    class ShowErr,ErrDeactive errorNode;
