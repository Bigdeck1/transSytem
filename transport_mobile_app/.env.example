# ====================================================
# JRR Transport Mobile Driver App
# Copy this file to .env and fill in your values
# ====================================================

# ─── Supabase Cloud Database ─────────────────────────
# These MUST be prefixed with EXPO_PUBLIC_ to be accessible in Expo
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── API Server URL (Optional) ───────────────────────
# Point to your deployed Web Hub for REST API calls
# EXPO_PUBLIC_API_URL=https://jrr-transport.onrender.com
