{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "lib": ["esnext", "dom"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "sourceMap": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "main.ts",
    "preload.ts",
    "ipc/**/*.ts",
    "server/**/*.ts",
    "global.d.ts",
    "renderer/js/**/*.ts"
  ],
  "exclude": ["node_modules"]
}