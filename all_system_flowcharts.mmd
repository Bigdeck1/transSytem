%% =============================================================================
%% 0. MASTER END-TO-END OPERATIONAL & FINANCIAL LIFECYCLE
%% =============================================================================
flowchart TD
    M0([0. Order Ingestion: Web Booking or Dispatcher Booking]) --> M1{Booking Channel?}
    M1 -- Public Customer Portal --> M1_Web[Process 21: Customer Books via transport_web_site/booking.html]
    M1_Web --> M1_Proxy[api.php Proxies to Supabase: Upsert clients & Create TRP-WEB- Trip]
    M1 -- Dispatcher Console --> M1_Disp[Process 4: Dispatcher Schedules Trip on scheduling_page.html]
    M1_Proxy & M1_Disp --> M1_Pricing[Process 24: Evaluate client_rate_cards Contract Pricing Matrix]
    
    M1_Pricing --> M2[Process 3: Vehicle Pre-Trip 12-Point Inspection on vehicles_page.html]
    M2 --> M3{Passed Pre-Trip Inspection?}
    M3 -- No --> M4[Vehicle Quarantined to 'maintenance' -> Reassign Vehicle] --> M1_Disp
    M3 -- Yes --> M5[Driver Departs Depot: Status = 'in transit']
    
    M5 --> M6[Process 5: Live GPS Pings -> driver_locations Table]
    M6 --> M7[Process 5: 5-Stage Customer Milestone Webhook Dispatched]
    M6 --> M8[Process 14: Consignee Monitors Live on public_track.html]
    M5 --> M_Multi{Process 22: Multi-Stop Delivery?}
    M_Multi -- Yes --> M_Stops[Sequential Delivery to trip_stops Waypoints with Per-Stop Signatures]
    M_Multi -- No --> M9
    M_Stops --> M9
    
    M9{En-Route Event Occurs?}
    M9 -- Refuel / Tollway --> M10[Process 8: Driver Logs Expense via POST /api/expenses/log]
    M9 -- Breakdown / SOS --> M11[Process 7: Driver Reports Incident -> Admin Siren Alarm & Status Review]
    M9 -- Normal Transit --> M12[Driver Arrives at Final Consignee Destination]
    
    M12 --> M13[Process 6: Driver Submits e-POD Signature & Gate Photo]
    M13 --> M14[Status = 'delivered' -> Driver & Vehicle Status Reset to 'available']
    M14 --> M15[Process 9: Billing Generates Sequential Invoice in billing.html]
    M15 --> M16[Process 11: Daily Attendance Logged in attendance Table]
    M16 --> M17[Process 12: Payroll Runs with calcHours, SSS/PhilHealth/TRAIN Tax -> paychecks Table]
    M17 --> M18[Process 18: Generate Printable Operations & Financial Report]
    M18 --> M19([Trip Closed, Assets Cleared & Accounts Reconciled])

%% =============================================================================
%% 1. AUTHENTICATION, DUAL-STORE FALLBACK & SESSION SECURITY
%% =============================================================================
flowchart TD
    A1([User Visits index.html]) --> A2[/Enter Email/Username & Password/]
    A2 --> A3[Click Login / POST /api/auth/login]
    
    A3 --> A_AdminCheck{Is Super Admin Master Credential?\nadmin or admin@jrr.com + admin}
    A_AdminCheck -- Yes --> A_SuperAdmin[Instant HTTP 200: Return role = 'super_admin']
    A_AdminCheck -- No --> A_RateCheck{loginAttempts >= 5?}
    
    A_RateCheck -- Yes --> A_Lock[Return HTTP 429: Account locked for 15 minutes] --> A2
    A_RateCheck -- No --> A4[Call Supabase Auth signInWithPassword]
    
    A4 --> A5{Valid Supabase Auth?}
    A5 -- No --> A_Fallback[(Fallback Query users Table:\nWHERE email = ? AND password = ?)]
    A_Fallback --> A_FallbackCheck{User Record Found?}
    A_FallbackCheck -- No --> A6[Increment loginAttempts\nDisplay 'Invalid credentials'] --> A2
    A_FallbackCheck -- Yes --> A8_Check
    
    A5 -- Yes --> A7[Receive Supabase Access Token & User ID]
    A7 --> A8_Check{Check users Approval}
    
    A8_Check --> A_VerCheck{email_verified == false?}
    A_VerCheck -- Yes --> A_ErrVer[Return HTTP 403: Verify email first] --> A2
    A_VerCheck -- No --> A_AppCheck{account_status != 'approved'?}
    A_AppCheck -- Yes --> A_ErrApp[Return HTTP 403: Pending admin approval] --> A2
    A_AppCheck -- No --> A8[(Query employees Table\nWHERE supabase_user_id = user.id)]
    
    A8 --> A9{Is Employee Status Active?}
    A9 -- No --> A10[HTTP 403: Account Inactive / Suspended] --> A2
    A9 -- Yes --> A11[Clear loginAttempts\nSave Token & Profile in LocalStorage]
    
    A11 --> A_Inactivity[auth_guard.js Starts 30-Min Inactivity Timer\nTracks mousemove, keydown, click, scroll]
    A11 --> A12{Check User Position}
    A12 -- Admin / Manager --> A13[Redirect to dashboard.html]
    A12 -- Driver --> A14[Redirect to tracking.html / mobile app]
    A12 -- Staff / Dispatcher --> A15[Redirect to scheduling_page.html]

    subgraph Auth_Recovery ["Secure 3-Stage 6-Digit OTP Password Recovery"]
        AR1([Click 'Forgot Password?']) --> AR2[Open forgot_password_page.html]
        AR2 --> AR3[/Enter Registered Email/]
        AR3 --> AR4[POST /api/auth/send-recovery-code]
        AR4 --> AR5[Generate 6-Digit OTP in recoveryCodes Map\nDispatches SMTP Email via NodeMailer]
        AR5 --> AR6[/Enter 6-Digit OTP Verification Code/]
        AR6 --> AR7[POST /api/auth/verify-recovery-code]
        AR7 --> AR8{Valid Code & recoveryAttempts < 5?}
        AR8 -- No --> AR9[Show 'Invalid or Expired Code' Notice] --> AR6
        AR8 -- Yes --> AR10[/Enter New Password (min 8 chars)/]
        AR10 --> AR11[POST /api/auth/update-password-with-code]
        AR11 --> AR12[(Update users Table & Admin API updateUserById)]
        AR12 --> AR13([Password Reset Successful])
    end

