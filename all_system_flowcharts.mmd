%% 2. EMPLOYEE ONBOARDING, IDENTITY PROVISIONING & ACCOUNT SYNC
%% =============================================================================
flowchart TD
    B1([Admin Opens employee_management.html]) --> B2[GET /api/employees/next-id]
    B2 --> B3[Auto-Suggest Next Sequential ID e.g. EMP0009]
    B3 --> B4[/Enter Full Name, Email, Phone, Daily Rate, Position, Department/]
    B4 --> B5{Form Input Valid?}
    B5 -- No --> B6[Show Validation Error Alert] --> B4
    B5 -- Yes --> B7[POST /api/employees/create]
    B7 --> B8[Supabase Admin API: createUser in auth.users]
    B8 --> B9[(Insert Profile into employees Table:\nsupabase_user_id = authData.user.id, status = 'available')]
    B9 --> B10([Employee Ready for Assignment])

    subgraph Employee_Account_Sync ["Email Account Sync / Linking"]
        BS1([Admin Triggers Account Sync]) --> BS2[POST /api/employees/sync-email]
        BS2 --> BS3{User Exists in users Table?}
        BS3 -- Yes --> BS4[(Link existing user.id to employees.supabase_user_id)]
        BS3 -- No --> BS5[Create Supabase Auth User + users row\nDefault Password: EMP + UPPERCASE_NAME]
        BS5 --> BS4
        BS4 --> BS6([Account Synchronized])
    end

    subgraph Employee_Delete_Guard ["Cascade Safety Deletion"]
        BD1([Delete Request: DELETE /api/employees/:id]) --> BD2{Driver Assigned to Active Trips?}
        BD2 -- Yes --> BD3[Reject HTTP 400: Active Trips Exist]
        BD2 -- No --> BD4[Delete auth.users Record via Admin API]
        BD4 --> BD5[(Delete employees Record)]
        BD5 --> BD6([Employee Safely Removed])
    end

%% =============================================================================
%% 3. VEHICLE FLEET, PRE-TRIP CHECKLIST & PREVENTIVE MAINTENANCE (PMS)
%% =============================================================================
flowchart TD
    subgraph Reactive_PreTrip ["Reactive Safety: Pre-Trip Inspection"]
        C1([Vehicle in Depot]) --> C2[Driver / Inspector Conducts Physical Inspection]
        C2 --> C3[/Fill 12-Point Checklist: Odometer, Fuel %, Brakes, Tires, Horn, Fluids/]
        C3 --> C4[POST /api/vehicles/assessments]
        C4 --> C5[(Insert into vehicle_assessments Table)]
        C5 --> C6{Critical Failure or Status == 'failed'?}
        C6 -- Yes --> C7[(Trigger: UPDATE vehicles SET status = 'maintenance')]
        C7 --> C8([Vehicle Locked from Dispatch Schedule])
        C8 --> C9[Workshop Mechanics Complete Repairs]
        C9 --> C10[POST /api/vehicles/:id/clear-maintenance]
        C10 --> C11[(UPDATE vehicles SET status = 'available')]
        C6 -- No --> C11
        C11 --> C12([Vehicle Cleared for Dispatch])
    end

    subgraph Proactive_PMS ["Proactive Safety: Preventive Maintenance Schedules (PMS)"]
        CP1[(maintenance_schedules Table)] --> CP2[Track Service Types:\nengine_oil, tire_rotation, brake_pads, battery, renewal]
        CP2 --> CP3{Current Odometer vs next_due_odo}
        CP3 -- Current >= next_due_odo --> CP4[Set status = 'overdue'\nTrigger Urgent Vehicle Service Warning]
        CP3 -- Within 500 km --> CP5[Set status = 'due_soon']
        CP3 -- Normal Range --> CP6[Set status = 'healthy']
        CP4 --> C7
    end

%% =============================================================================
%% 4. TRIP SCHEDULING, ROUTE CALCULATION & CONFLICT PREVENTER
%% =============================================================================
flowchart TD
    D1([Dispatcher Opens scheduling_page.html]) --> D2[Select Pickup & Delivery Coordinates]
    D2 --> D3[POST /api/tracking/estimate-route]
    D3 --> D4[OSRM Dual-Leg Routing:\nLeg 1: HQ -> Pickup | Leg 2: Pickup -> Destination\nTotal Distance km & Duration Computed]
    D4 --> D5[POST /api/tracking/estimate-package\nVolumetric Weight & Vehicle Recommendation]
    D5 --> D_Price[Lookup client_rate_cards: Compute Contract Fare]
    D_Price --> D6[/Select Driver, Vehicle, Cargo & Timestamps/]
    
    D6 --> D7[Click Schedule Trip / POST /api/trips]
    D7 --> D8{Delivery Time > Pickup Time?}
    D8 -- No --> D9[Reject: Delivery Before Pickup] --> D6
    D8 -- Yes --> D10{Driver Assigned to Another Active Trip?}
    D10 -- Yes --> D11[Reject: Driver Busy In-Transit] --> D6
    D10 -- No --> D12{Vehicle Assigned to Another Active Trip?}
    D12 -- Yes --> D13[Reject: Vehicle Busy In-Transit] --> D6
    D12 -- No --> D14[Generate Unique TRK-XXXXXXXX Code]
    
    D14 --> D15[(Insert into trips Table:\nstatus: 'scheduled')]
    D15 --> D16[(UPDATE employees SET status = 'in-use')]
    D15 --> D17[(UPDATE vehicles SET status = 'in-use')]
    D15 --> D18[(Insert into notifications for Driver)]
    D18 --> D19([Trip Scheduled & Assets Locked])

    subgraph Trip_Mod_And_Delete ["Trip Modification & Cancellation Auto-Release"]
        DM1([PUT /api/trips/:id]) --> DM2[Update Route/Timestamps with Validation]
        DD1([DELETE /api/trips/:id]) --> DD2[(Delete trips Record)]
        DD2 --> DD3{Driver has other active trips?}
        DD3 -- No --> DD4[(UPDATE employees SET status = 'available')]
        DD2 --> DD5{Vehicle has other active trips?}
        DD5 -- No --> DD6[(UPDATE vehicles SET status = 'available')]
    end

%% =============================================================================
%% 5. LIVE GPS TRACKING & 5-STAGE CUSTOMER MILESTONE WEBHOOKS
%% =============================================================================
flowchart TD
    E1[Driver Mobile GPS Loop every 10s] --> E2[POST /api/tracking/driver-location]
    E2 --> E3[(Upsert driver_locations Table:\nlatitude, longitude, speed, heading, updated_at)]
    
    E_Stat[Trip Status Transition Occurs] --> E_Web[notificationWebhook.ts sendCustomerMilestoneEmail]
    E_Web --> E_QueryClient[(Lookup Client Email & Phone from clients Table)]
    E_QueryClient --> E_HasEmail{Client Email on File?}
    
    E_HasEmail -- Yes --> E_Branch{Evaluate Status}
    E_Branch -- 'booked' --> E_S1[Milestone 1: 'ORDER BOOKED' Email]
    E_Branch -- 'in-transit' --> E_S2[Milestone 2: 'OUT FOR DELIVERY' Email with Driver Name & Live Google Maps Link]
    E_Branch -- 'approaching' --> E_S3[Milestone 3: 'ARRIVING SOON' Email Warning Consignee 10-15 Min]
    E_Branch -- 'delivered' --> E_S4[Milestone 4: 'DELIVERED ✓' Email with Signatory & Gate Photo]
    E_Branch -- 'failed' --> E_S5[Milestone 5: 'DELIVERY ATTEMPTED' Email with Failure Reason & Re-attempt Options]
    
    E_HasEmail -- No --> E_Skip[Log: Skipped milestone email - no email on record]
    
    E_Stat --> E_IsDelivered{Status == 'delivered' or 'completed'?}
    E_IsDelivered -- Yes --> E_CheckD{Driver has other active trips?}
    E_CheckD -- No --> E_FreeD[(UPDATE employees SET status = 'available')]
    E_IsDelivered --> E_CheckV{Vehicle has other active trips?}
    E_CheckV -- No --> E_FreeV[(UPDATE vehicles SET status = 'available')]

