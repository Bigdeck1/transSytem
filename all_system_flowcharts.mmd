%% 24. CLIENT CONTRACT RATE CARDS & DYNAMIC FREIGHT PRICING
%% =============================================================================
flowchart TD
    Z1([Admin Opens Rate Cards Setup]) --> Z2[(client_rate_cards Table)]
    Z2 --> Z3[/Configure Base Fare, Base Distance km, Per-Km Rate, Dropoff Surcharge/]
    Z3 --> Z4[Dispatcher Schedules Order for Client]
    Z4 --> Z5[Query client_rate_cards for Client ID]
    Z5 --> Z6{Contract Rate Card Found?}
    Z6 -- Yes --> Z7[Apply Client Specific Rate Card Rules]
    Z6 -- No --> Z8[Apply Default Rate Card Matrix]
    Z7 & Z8 --> Z9["Compute Total Fare:\nFare = max(Base Fare + (Trip Km - Base Km) * Per Km Rate + Stops * Surcharge, Min Charge)"]
    Z9 --> Z10[(Save estimated_fare on trips Table)]
    Z10 --> Z11[Auto-Populate Invoicing Amount on billing.html]
