%% =============================================================================
%% 21. PUBLIC CUSTOMER WEB BOOKING PORTAL
%% =============================================================================
flowchart TD
    W1([Customer Visits transport_web_site/booking.html]) --> W2[/Enter Full Name, Email, Phone, Vehicle, Date, Time, Address/]
    W2 --> W3[Click Book Now / POST api.php]
    W3 --> W4{Client Phone Found in clients Table?}
    W4 -- Yes --> W5[PATCH clients SET name = ?, email = ?]
    W4 -- No --> W6[(Insert clients Table:\nclient_type: 'Individual', company_name: 'Website Booking')]
    W5 & W6 --> W7[Resolve client_id]
    W7 --> W8[(Insert into trips Table:\ntrip_number: 'TRP-WEB-timestamp'\nstatus: 'scheduled'\ncargo: 'Website Booking: ' + vehicleName)]
    W8 --> W9[Return HTTP 200 Booking Confirmation & Booking ID to Customer]
    W9 --> W10([Order Queued in Dispatch Console])

%% =============================================================================
%% 22. MULTI-STOP DISPATCH, WAYPOINT MANIFESTS & TMS ENGINE
%% =============================================================================
flowchart TD
    X1([Dispatcher Configures Multi-Drop Run]) --> X2[/Add Waypoint Stops 1 to N/]
    X2 --> X3[(Insert trip_stops Table:\n• stop_sequence\n• stop_type: pickup/dropoff/waypoint\n• location_name, address\n• tracking_code per stop\n• status: 'pending')]
    X3 --> X4[Driver Starts Trip Manifest on Mobile App]
    X4 --> X5[Driver Navigates to Stop i]
    X5 --> X6{Dropoff Successful?}
    X6 -- Yes --> X7[Capture Stop e-POD: Recipient Name, Signature, Gate Photo]
    X7 --> X8[(UPDATE trip_stops SET status = 'delivered', delivered_at = NOW\(\))]
    X6 -- No --> X9[Log failed_reason & photo -> UPDATE trip_stops SET status = 'failed']
    X8 & X9 --> X10{More Stops in Sequence?}
    X10 -- Yes --> X5
    X10 -- No --> X11[(UPDATE trips SET status = 'delivered')]
    X11 --> X12([Multi-Stop Manifest Closed])

