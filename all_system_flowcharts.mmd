    F7 -- Yes --> F9[(UPDATE trips Table:\nstatus = 'delivered'\npod_recipient_name, pod_signature_data\npod_photo_url, pod_delivered_at = NOW\(\))]
    F9 --> F10[Trigger Delivery Milestone Email to Client]
    F10 --> F11[Release Driver & Vehicle Status to 'available']
    F11 --> F12([Delivery Completed & Certified])

