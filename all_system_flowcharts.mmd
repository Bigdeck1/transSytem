    subgraph Incident_Lifecycle ["Incident Resolution Management"]
        GL1[Dispatcher Reviews Incident] --> GL2[PATCH /api/incidents/:id/status\nstatus = 'under_review']
        GL2 --> GL3[Dispatches Mechanics / Police Assistance]
        GL3 --> GL4[PATCH /api/incidents/:id/status\nstatus = 'resolved'\nresolved_at = NOW\(\)]
