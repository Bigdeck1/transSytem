%% =============================================================================
%% 12. PAYROLL COMPUTATION & PHILIPPINE STATUTORY TAX (TRAIN LAW)
%% =============================================================================
flowchart TD
    L1([Payroll Officer Opens payroll_management.html]) --> L2[Select Target Month: YYYY-MM]
    L2 --> L3[GET /api/payroll/monthly-all]
    L3 --> L4[Query attendance Table for Month]
    L4 --> L5["Compute Shift Hours: calcHours(check_in, check_out)\nDaily Pay = daily_rate * min(hours / 8.0, 1.0)"]
    L5 --> L6[Calculate SSS Contribution Bracket Table]
    L5 --> L7[Calculate PhilHealth Mandatory Rate Split]
    L5 --> L8[Calculate Pag-IBIG HDMF Statutory Share]
    L6 & L7 & L8 --> L9[Compute Taxable Income = Gross - Statutory Deductions]
    L9 --> L10[Apply Philippine BIR TRAIN Law Graduated Withholding Tax]
    L10 --> L11[Compute Net Take-Home Pay]
    
    L11 --> L_Mail[POST /api/payroll/send-payslip\nDispatches Formatted HTML Payslip Email via SMTP]
    L11 --> L_Final[POST /api/payroll/finalize]
    L_Final --> L_Del[(Delete previous draft paychecks for month)]
    L_Del --> L_Save[(Insert into paychecks Table:\nstatus = 'paid')]
    L_Save --> L_Notif[(Insert notifications Table:\ntype = 'paycheck'\ntitle = 'Paycheck Ready')]
    L_Notif --> L12([Payroll Closed & Staff Notified])

